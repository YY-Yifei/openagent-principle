# openagent-principle 的全部配置都来自环境变量。
# 复制一份成 .env 并填自己的值，或直接 export。
# 缺省值就是「不配也能跑」的那一档：没有 key 时 judge 自动降级到纯规则后端。

# ---------- 存储 ----------
# 原则库 / 案例 / 反馈的落盘目录。
# 默认是**项目级**：<项目根>/.openagent-principle（见 `principles home`）。
# 设了就覆盖项目级发现，优先级最高。
# PRINCIPLE_HOME=~/.openagent-principle

# ---------- 判断后端 ----------
# auto（默认）| jev | llm | rules
#   jev   = 打 JEV 端点（结构化判断，主路径）
#   llm   = 用 OpenAI 兼容的 chat/completions 按**同一套题型**判断
#   rules = 只用原则里的机器可判规则，纯本地、不发任何请求
#   auto  = 配了 JEV 就用 jev，失败降级 llm，再降级 rules
# PRINCIPLE_JUDGE_BACKEND=auto

# ---------- JEV（主判断后端，可选） ----------
# JEV 端点：填你自己的网关地址（需要暴露 /systemone 路由）。
# JEV_BASE_URL=https://your-jev-gateway.example.com
# JEV_PATH=/systemone/v1/systemone
# JEV_MODEL=jev-1.13.0
# JEV_API_KEY=            # 缺省回落到 PRINCIPLE_API_KEY / OPENAI_API_KEY
# JEV_TIMEOUT=120

# ---------- LLM（agent 与 llm 判断后端共用） ----------
# 缺省按 DEEPSEEK_API_KEY / OPENAI_API_KEY 的顺序找 key。
# PRINCIPLE_API_KEY=
# PRINCIPLE_BASE_URL=https://api.deepseek.com
# PRINCIPLE_MODEL=deepseek-flash
# PRINCIPLE_CONTEXT_SIZE=1048576
# PRINCIPLE_TEMPERATURE=0.3
# PRINCIPLE_MAX_TOKENS=4096
# PRINCIPLE_MAX_ITERS=200

# ---------- 预算 ----------
# 单次判断最多带多少条原则（JEV 按调用计费，一次装够才划算）
# PRINCIPLE_MAX_PRINCIPLES_PER_JUDGE=12
# 单次判断送进模型的材料字符上限
# PRINCIPLE_MAX_MATERIAL_CHARS=12000
# agent 每轮允许的 judge / 读文件次数（护栏，代码强制；0 = 不限，默认不限）
# PRINCIPLE_MAX_JUDGE_CALLS=0
# PRINCIPLE_MAX_READ_CALLS=0
# 兼容字段：fetch_url 已移除，设了也不会有工具命中
# PRINCIPLE_MAX_FETCH_CALLS=0
